# Copia este archivo a .env y completa los valores. .env NO se sube a ningún repositorio.

# Usuario de la APLICACIÓN (rol ova_app: sin permisos de dueño, sujeto a la seguridad por fila)
DATABASE_URL=postgres://ova_app:CLAVE_DE_LA_APP@localhost:5432/ova

# Usuario DUEÑO de la base: solo para ejecutar las migraciones (npm run db:migrar)
DATABASE_URL_DUENO=postgres://postgres:CLAVE_DEL_DUENO@localhost:5432/ova

# Mínimo 32 caracteres aleatorios. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001
# La sesión se renueva sola mientras se usa: vence tras estos días SIN actividad, y en todo caso a los N días de haber iniciado.
SESION_DIAS_INACTIVIDAD=7
SESION_DIAS_MAXIMO=30

# En producción (HTTPS) pon true
COOKIE_SEGURA=false

# Carpeta con la plataforma compilada, para servirla desde este mismo servidor
CARPETA_WEB=../plataforma-react/dist
