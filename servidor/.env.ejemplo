# Copia este archivo a .env y completa los valores. .env NO se sube a ningún repositorio.

# Usuario de la APLICACIÓN (rol ova_app: sin permisos de dueño, sujeto a la seguridad por fila)
DATABASE_URL=postgres://ova_app:CLAVE_DE_LA_APP@localhost:5432/ova

# Usuario DUEÑO de la base: solo para ejecutar las migraciones (npm run db:migrar)
DATABASE_URL_DUENO=postgres://postgres:CLAVE_DEL_DUENO@localhost:5432/ova

# Mínimo 32 caracteres aleatorios. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001
# La sesión se renueva sola mientras se usa: vence tras estos días SIN actividad, y en todo caso a los N días de haber iniciado.
SESION_DIAS_INACTIVIDAD=7
SESION_DIAS_MAXIMO=30

# En producción (HTTPS) pon true
COOKIE_SEGURA=false

# Carpeta con la plataforma compilada, para servirla desde este mismo servidor
CARPETA_WEB=../plataforma-react/dist

# Avisos de n8n a Praxia (pipeline guiones → matrices → H5P). n8n firma cada aviso con este secreto (HMAC-SHA256).
# Sin valor, el receptor POST /api/n8n/eventos queda desactivado. Mínimo 32 caracteres aleatorios; el mismo valor lo guarda n8n.
N8N_EVENTOS_SECRETO=
# Solo mientras se cambia el secreto: el valor viejo, para aceptar los dos a la vez.
N8N_EVENTOS_SECRETO_ANTERIOR=

# Webhooks de n8n a los que Praxia ENTREGA órdenes. Lo normal es guardarlos en la pantalla «Conexión n8n» (sin reiniciar); estas variables solo son el respaldo si ahí no hay una.
N8N_MATRICES_URL=
N8N_H5P_URL=

# Tope (MB) del paquete que Praxia envía a n8n en una orden; n8n acepta 16 MiB por defecto. Por encima, Praxia responde 413 con el tamaño, sin enviar nada.
# N8N_PAQUETE_MAX_MB=12
