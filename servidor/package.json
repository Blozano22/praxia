{
  "name": "ova-servidor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de la plataforma de recursos: usuarios, roles, permisos y enlaces por propietario (PostgreSQL).",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
